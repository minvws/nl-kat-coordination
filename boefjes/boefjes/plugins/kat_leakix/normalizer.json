{
  "id": "kat_leakix_normalize",
  "name": "LeakIX",
  "description": "Parses the LeakIX output into findings, identified software, TLS certificates and services.",
  "consumes": [
    "boefje/leakix"
  ],
  "produces": [
    "AutonomousSystem",
    "IPAddressV4",
    "IPAddressV6",
    "IPPort",
    "Hostname",
    "Software",
    "SoftwareInstance",
    "X509Certificate",
    "SubjectAlternativeNameHostname",
    "SubjectAlternativeNameQualifier",
    "KATFindingType",
    "CVEFindingType",
    "Finding"
  ]
}
